/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    oDIAFlow Trillium (DigitalAlliance) SLURM Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource settings optimized for Trillium HPC cluster (SLURM 24.05.4).
    
    Cluster Specs (from sinfo):
    - Primary partition: compute* (default)
    - Debug partition: debug (15 min max time, 4 CPU max)
    - Memory per node: ~750 GB (compute), ~509 GB (compute_neptune)
    - Time limits: 15 min (debug), unlimited (compute)
    - Job size: 1-infinite (compute), 1-4 (debug)
    
    Usage: nextflow run main.nf -profile singularity,trillium
    
    CRITICAL: This config REMOVES all memory settings from base.config.
    Nextflow will not generate --mem SBATCH directives if memory is not set.
    For multi-account access, consider using additional -c overrides.
----------------------------------------------------------------------------------------
*/

// Get user once at config load time to use in multiple places
def trillium_user = System.getenv("USER")

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "/scratch/${trillium_user}/singularity-cache"
    runOptions = "--bind /scratch/${trillium_user}:/scratch/${trillium_user} --env TMPDIR=/scratch/${trillium_user}/tmp --env HOME=/tmp --env XDG_CONFIG_HOME=/scratch/${trillium_user}/tmp/.config --env MPLCONFIGDIR=/scratch/${trillium_user}/tmp/matplotlib --env DUCKDB_HOME=/scratch/${trillium_user}/tmp/duckdb"
}

process {
    // REMOVE ALL MEMORY SETTINGS FOR TRILLIUM
    // This overrides the default from base.config: memory = { 6.GB * task.attempt }
    memory = null
    
    // IMPORTANT: Do NOT set memory limits on Trillium!
    // Trillium uses whole-node allocation (all 745 GiB per node)
    // Setting --mem in SBATCH causes "Invalid allocation" error
    
    // Default resources for Trillium compute partition (CPU and time only)
    cpus   = { 32 * task.attempt }
    time   = { 8.h * task.attempt }
    
    // =========================================================================
    // OVERRIDE ALL BASE.CONFIG LABELS TO REMOVE MEMORY
    // =========================================================================
    
    withLabel:process_tiny {
        memory = null
        cpus   = { 1 }
        time   = { 1.h * task.attempt }
    }
    
    withLabel:process_single {
        memory = null
        cpus   = { 1 }
        time   = { 4.h * task.attempt }
    }
    
    withLabel:process_low {
        memory = null
        cpus   = { 4 * task.attempt }
        time   = { 6.h * task.attempt }
    }
    
    withLabel:process_very_low {
        memory = null
        cpus   = { 2 * task.attempt }
        time   = { 3.h * task.attempt }
    }
    
    withLabel:process_medium {
        memory = null
        cpus   = { 8 * task.attempt }
        time   = { 8.h * task.attempt }
    }
    
    withLabel:process_high {
        memory = null
        cpus   = { 12 * task.attempt }
        time   = { 16.h * task.attempt }
    }
    
    withLabel:process_long {
        time   = { 20.h * task.attempt }
    }
    
    withLabel:process_high_memory {
        memory = null
    }
    
    // =========================================================================
    // PROCESS-SPECIFIC OVERRIDES (sorted by pipeline tool)
    // =========================================================================

    // -------------------------------------------------------------------------
    // SAGE Search (compute-heavy, parallelizable)
    // -------------------------------------------------------------------------
    withName: '.*SAGE_SEARCH.*' {
        memory = null  // Override modules.config memory setting for Trillium
        cpus   = { 64 * task.attempt }
        time   = { 6.h * task.attempt }
        maxForks = 2  // Limit concurrent large SAGE jobs to avoid cluster overload
    }

    withName: '.*SAGE_COMBINE_RESULTS' {
        memory = null
        cpus   = 8
        time   = { 2.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // EasyPQP
    // -------------------------------------------------------------------------
    withName: '.*EASYPQP_CONVERTSAGE' {
        memory = null
        cpus   = 16
        time   = { 4.h * task.attempt }
    }

    withName: '.*EASYPQP_LIBRARY' {
        memory = null
        cpus   = 8
        time   = { 4.h * task.attempt }
    }

    withName: '.*EASYPQP_REDUCE' {
        memory = null
        cpus   = 4
        time   = { 1.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // OpenSWATH Tools (memory-intensive workflows)
    // -------------------------------------------------------------------------
    withName: '.*OPENSWATHASSAYGENERATOR' {
        memory = null
        cpus   = 8
        time   = { 2.h * task.attempt }
    }

    withName: '.*OPENSWATHDECOYGENERATOR' {
        memory = null
        cpus   = 8
        time   = { 2.h * task.attempt }
    }

    withName: '.*OPENSWATHWORKFLOW' {
        memory = null
        cpus   = { 64 * task.attempt }
        time   = { 16.h * task.attempt }
        maxForks = 2  // Limit to avoid node congestion
    }

    // -------------------------------------------------------------------------
    // PyProphet (statistical inference, multi-threaded)
    // -------------------------------------------------------------------------
    withName: '.*PYPROPHET_MERGE' {
        memory = null
        cpus   = 8
        time   = { 2.h * task.attempt }
    }

    withName: '.*PYPROPHET_PEAKGROUP_SCORING' {
        memory = null
        cpus   = 16
        time   = { 6.h * task.attempt }
    }

    withName: '.*PYPROPHET_ALIGNMENT_SCORING' {
        memory = null
        cpus   = 16
        time   = { 4.h * task.attempt }
    }

    withName: '.*PYPROPHET_INFER_PEPTIDE' {
        memory = null
        cpus   = 8
        time   = { 3.h * task.attempt }
    }

    withName: '.*PYPROPHET_INFER_PROTEIN' {
        memory = null
        cpus   = 8
        time   = { 3.h * task.attempt }
    }

    withName: '.*PYPROPHET_EXPORT_TSV' {
        memory = null
        cpus   = 8
        time   = { 2.h * task.attempt }
    }

    withName: '.*PYPROPHET_CALIBRATION_REPORT' {
        memory = null
        cpus   = 16
        time   = { 4.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // Arycal (alignment, compute-intensive)
    // -------------------------------------------------------------------------
    withName: '.*ARYCAL' {
        memory = null
        cpus   = { 64 * task.attempt }
        time   = { 16.h * task.attempt }
        maxForks = 1  // Run one at a time to manage node load
    }

    // -------------------------------------------------------------------------
    // File Conversion & I/O
    // -------------------------------------------------------------------------
    withName: '.*DIAPYSEF_TDF_TO_MZML' {
        memory = null
        cpus   = 8
        time   = { 4.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // Small utility tasks (file merging, sorting, etc.)
    // -------------------------------------------------------------------------
    withName: '.*PYPROPHET_MERGE_OSWPQ' {
        memory = null
        cpus   = 4
        time   = { 2.h * task.attempt }
    }

    withName: '.*PYPROPHET_EXPORT_PARQUET' {
        memory = null
        cpus   = 8
        time   = { 2.h * task.attempt }
    }
}
