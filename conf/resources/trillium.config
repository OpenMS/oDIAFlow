/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    oDIAFlow Trillium (DigitalAlliance) SLURM Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource settings optimized for Trillium HPC cluster (SLURM 24.05.4).
    
    Cluster Specs (from sinfo):
    - Primary partition: compute* (default)
    - Debug partition: debug (15 min max time, 4 CPU max)
    - Memory per node: ~750 GB (compute), ~509 GB (compute_neptune)
    - Time limits: 15 min (debug), unlimited (compute)
    - Job size: 1-infinite (compute), 1-4 (debug)
    
    Usage: nextflow run main.nf -profile singularity,slurm,trillium
    
    Note: Update ACCOUNT and PROJECT variables in profile configuration.
    For multi-account access, consider using additional -c overrides.
----------------------------------------------------------------------------------------
*/

process {
    // Default resources for Trillium compute partition
    cpus   = { 32 * task.attempt }
    memory = { 128.GB * task.attempt }
    time   = { 8.h * task.attempt }

    // -------------------------------------------------------------------------
    // SAGE Search (compute-heavy, parallelizable)
    // -------------------------------------------------------------------------
    withName: '.*SAGE_SEARCH.*' {
        cpus   = { 64 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 6.h * task.attempt }
        maxForks = 2  // Limit concurrent large SAGE jobs to avoid cluster overload
    }

    withName: '.*SAGE_COMBINE_RESULTS' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // EasyPQP
    // -------------------------------------------------------------------------
    withName: '.*EASYPQP_CONVERTSAGE' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: '.*EASYPQP_LIBRARY' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: '.*EASYPQP_REDUCE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // OpenSWATH Tools (memory-intensive workflows)
    // -------------------------------------------------------------------------
    withName: '.*OPENSWATHASSAYGENERATOR' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: '.*OPENSWATHDECOYGENERATOR' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: '.*OPENSWATHWORKFLOW' {
        cpus   = { 64 * task.attempt }
        memory = { 80.GB * task.attempt }
        time   = { 16.h * task.attempt }
        maxForks = 2  // Limit to avoid memory exhaustion on shared nodes
    }

    // -------------------------------------------------------------------------
    // PyProphet (statistical inference, multi-threaded)
    // -------------------------------------------------------------------------
    withName: '.*PYPROPHET_MERGE' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: '.*PYPROPHET_PEAKGROUP_SCORING' {
        cpus   = 16
        memory = { 128.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: '.*PYPROPHET_ALIGNMENT_SCORING' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: '.*PYPROPHET_INFER_PEPTIDE' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 3.h * task.attempt }
    }

    withName: '.*PYPROPHET_INFER_PROTEIN' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 3.h * task.attempt }
    }

    withName: '.*PYPROPHET_EXPORT_TSV' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: '.*PYPROPHET_CALIBRATION_REPORT' {
        cpus   = 16
        memory = { 128.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // Arycal (alignment, very memory-intensive)
    // -------------------------------------------------------------------------
    withName: '.*ARYCAL' {
        cpus   = { 64 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
        maxForks = 1  // Run one at a time to avoid memory pressure
    }

    // -------------------------------------------------------------------------
    // File Conversion & I/O
    // -------------------------------------------------------------------------
    withName: '.*DIAPYSEF_TDF_TO_MZML' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // -------------------------------------------------------------------------
    // Small utility tasks (file merging, sorting, etc.)
    // -------------------------------------------------------------------------
    withName: '.*PYPROPHET_MERGE_OSWPQ' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: '.*PYPROPHET_EXPORT_PARQUET' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
}
